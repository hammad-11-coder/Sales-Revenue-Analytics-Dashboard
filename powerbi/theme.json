{
  "name": "Sales Revenue Analytics - Portfolio",
  "dataColors": [
    "#1D4ED8",
    "#C2410C",
    "#7C3AED",
    "#15803D",
    "#DB2777",
    "#9CA3AF",
    "#B91C1C",
    "#CA8A04"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#1D4ED8",
  "good": "#15803D",
  "neutral": "#6B7280",
  "bad": "#B91C1C",
  "maximum": "#1D4ED8",
  "center": "#E5E7EB",
  "minimum": "#BFDBFE",
  "null": "#9CA3AF",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B2545"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#4B5563"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B2545"
              }
            },
            "fontSize": 12,
            "bold": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5E7EB"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F4F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
